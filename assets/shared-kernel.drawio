<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net">
  <diagram id="overview" name="调用图">
    <mxGraphModel tooltips="1" fold="1" connect="1" page="1" pageWidth="1090" pageHeight="620">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <object id="api" label="sumGrid">
          <mxCell style="rounded=1;whiteSpace=wrap;fontSize=18;fontStyle=1;fontFamily=Times New Roman,Helvetica,Arial,sans-serif;" vertex="1" parent="1">
            <mxGeometry as="geometry" x="40" y="193" width="155" height="42" />
          </mxCell>
        </object>
        <object id="api-tooltip" label="" tooltip="unsigned sumGrid(const unsigned* values, bool byRow)&#10;&#10;功能&#10;对第二行或第二列求和。&#10;&#10;参数&#10;- values：按行优先存储的 2×2 网格。&#10;- byRow：为 true 时选择第二行，为 false 时选择第二列。&#10;&#10;源码&#10;demo/grid.cc:57">
          <mxCell parent="api" vertex="1" connectable="0" style="ellipse;aspect=fixed;fillColor=#FFD966;strokeColor=#B58D17;strokeWidth=1;tooltipCell=1;movable=0;resizable=0;rotatable=0;deletable=0;">
            <mxGeometry x="1" y="0" width="11" height="11" relative="1" as="geometry">
              <mxPoint x="-16" y="5" as="offset" />
            </mxGeometry>
          </mxCell>
        </object>
        <object id="axis" label="byRow" tooltip="在 sumGrid 中判断 byRow。&#10;demo/grid.cc:59">
          <mxCell vertex="1" parent="1" style="shape=rhombus;whiteSpace=wrap;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=18;fontStyle=1;fontFamily=Times New Roman,Helvetica,Arial,sans-serif;">
            <mxGeometry as="geometry" x="240" y="168" width="130" height="92" />
          </mxCell>
        </object>
        <object id="row" label="sumRow" tooltip="unsigned sumRow(const unsigned* values)&#10;&#10;功能&#10;对第二行的相邻元素求和。&#10;&#10;参数&#10;- values：按行优先存储的 2×2 网格。&#10;&#10;源码&#10;demo/grid.cc:43">
          <mxCell style="swimlane;startSize=38;horizontal=1;collapsible=1;fontSize=18;fontStyle=1;fontFamily=Times New Roman,Helvetica,Arial,sans-serif;" vertex="1" parent="1">
            <mxGeometry as="geometry" x="443" y="56" width="244" height="134">
              <mxRectangle as="alternateBounds" x="443" y="56" width="244" height="38" />
            </mxGeometry>
          </mxCell>
        </object>
        <object id="col" label="sumColumn" tooltip="unsigned sumColumn(const unsigned* values)&#10;&#10;功能&#10;以两个元素为步长对第二列求和。&#10;&#10;参数&#10;- values：按行优先存储的 2×2 网格。&#10;&#10;源码&#10;demo/grid.cc:48">
          <mxCell style="swimlane;startSize=38;horizontal=1;collapsible=1;fontSize=18;fontStyle=1;fontFamily=Times New Roman,Helvetica,Arial,sans-serif;" vertex="1" parent="1" collapsed="1">
            <mxGeometry as="geometry" x="443" y="315" width="244" height="38">
              <mxRectangle as="alternateBounds" x="443" y="315" width="244" height="260" />
            </mxGeometry>
          </mxCell>
        </object>
        <object id="pr" label="secondRow" tooltip="const unsigned* secondRow(const unsigned* values)&#10;&#10;功能&#10;返回指向第二行第一个元素的指针。&#10;&#10;参数&#10;- values：按行优先存储的 2×2 网格。&#10;&#10;源码&#10;demo/grid.cc:9">
          <mxCell style="rounded=1;whiteSpace=wrap;fontSize=18;fontStyle=1;fontFamily=Times New Roman,Helvetica,Arial,sans-serif;" vertex="1" parent="row">
            <mxGeometry as="geometry" x="38" y="71" width="168" height="36" />
          </mxCell>
        </object>
        <object id="pc" label="makeColumnView" tooltip="ColumnView makeColumnView(const unsigned* values, unsigned rows, unsigned columns, unsigned column)&#10;&#10;功能&#10;构建列视图，记录首元素地址、行数和步长。&#10;&#10;参数&#10;- values：按行优先存储的网格。&#10;- rows：网格的行数。&#10;- columns：网格的列数。&#10;- column：从 0 开始的列号。&#10;&#10;源码&#10;demo/grid.cc:24">
          <mxCell style="rounded=1;whiteSpace=wrap;fontSize=18;fontStyle=1;fontFamily=Times New Roman,Helvetica,Arial,sans-serif;" vertex="1" parent="col">
            <mxGeometry as="geometry" x="19" y="63" width="206" height="36" />
          </mxCell>
        </object>
        <object id="kernel" label="sumRange" tooltip="unsigned sumRange(const unsigned* values, unsigned count, unsigned stride)&#10;&#10;功能&#10;读取当前元素，在 count 大于 1 时递归计算剩余元素的和。&#10;&#10;参数&#10;- values：指向待求和的第一个元素。&#10;- count：剩余元素的个数。&#10;- stride：相邻两个待求和元素的下标差。&#10;&#10;源码&#10;demo/grid.cc:34" link="data:page/id,kernel-detail">
          <mxCell style="rounded=1;whiteSpace=wrap;fontSize=18;fontStyle=1;fontFamily=Times New Roman,Helvetica,Arial,sans-serif;" vertex="1" parent="1">
            <mxGeometry as="geometry" x="815" y="190" width="170" height="48" />
          </mxCell>
        </object>
        <mxCell id="axis-row" value="是" source="axis" target="row" parent="1" edge="1" style="noEdgeStyle=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitPerimeter=0;entryX=0;entryY=0;entryDy=19;entryPerimeter=0;fontSize=18;fontStyle=1;">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="305" y="75" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="row-pack" value="" source="row" target="pr" parent="row" edge="1" style="noEdgeStyle=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDy=38;exitPerimeter=0;entryX=0.5;entryY=0;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="row-kernel" value="" source="row" target="kernel" parent="1" edge="1" style="noEdgeStyle=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0;exitDy=19;exitPerimeter=0;entryX=0;entryY=0.25;entryPerimeter=0;jumpStyle=arc;">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="729" y="75" />
              <mxPoint x="729" y="202" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="axis-col" value="否" source="axis" target="col" parent="1" edge="1" style="noEdgeStyle=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitPerimeter=0;entryX=0;entryY=0;entryDy=19;entryPerimeter=0;fontSize=18;fontStyle=1;">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="305" y="334" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="col-pack" value="" source="col" target="pc" parent="col" edge="1" style="noEdgeStyle=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDy=38;exitPerimeter=0;entryX=0.5;entryY=0;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="col-kernel" value="" source="col" target="kernel" parent="1" edge="1" style="noEdgeStyle=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0;exitDy=19;exitPerimeter=0;entryX=0;entryY=0.75;entryPerimeter=0;jumpStyle=arc;">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="760" y="334" />
              <mxPoint x="760" y="226" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="again" value="递归" source="kernel" target="kernel" parent="1" edge="1" style="noEdgeStyle=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;loopStyle=orthogonalLoopStyle;orthogonalLoop=1;dashed=1;exitX=0.75;exitY=0;exitPerimeter=0;entryX=0.35;entryY=0;entryPerimeter=0;fontSize=18;fontStyle=1;">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="942.5" y="136" />
              <mxPoint x="874.5" y="136" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="api-axis" source="api" target="axis" parent="1" edge="1" value="" style="noEdgeStyle=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <object id="axis-note" label="分支选择&#10;&#10;两个分支调用同一个 sumRange 函数，并使用不同的步长。" tooltip="sumRow 使用步长 1，sumColumn 使用步长 2。">
          <mxCell parent="1" vertex="1" style="rounded=1;html=0;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=15;fontStyle=0;">
            <mxGeometry as="geometry" x="815" y="315" width="220" height="125" />
          </mxCell>
        </object>
        <object id="element" label="gridElement" tooltip="const unsigned* gridElement(const unsigned* values, unsigned row, unsigned column, unsigned columns)&#10;&#10;功能&#10;返回网格中指定元素的地址。&#10;&#10;参数&#10;- values：按行优先存储的网格。&#10;- row：从 0 开始的行号。&#10;- column：从 0 开始的列号。&#10;- columns：网格的列数。&#10;&#10;源码&#10;demo/grid.cc:19">
          <mxCell style="rounded=1;whiteSpace=wrap;fontSize=18;fontStyle=1;fontFamily=Times New Roman,Helvetica,Arial,sans-serif;" vertex="1" parent="col">
            <mxGeometry as="geometry" x="19" y="128" width="206" height="36" />
          </mxCell>
        </object>
        <object id="offset" label="elementOffset" tooltip="unsigned elementOffset(unsigned row, unsigned column, unsigned columns)&#10;&#10;功能&#10;计算元素在行优先布局中的偏移。&#10;&#10;参数&#10;- row：从 0 开始的行号。&#10;- column：从 0 开始的列号。&#10;- columns：网格的列数。&#10;&#10;源码&#10;demo/grid.cc:14">
          <mxCell style="rounded=1;whiteSpace=wrap;fontSize=18;fontStyle=1;fontFamily=Times New Roman,Helvetica,Arial,sans-serif;" vertex="1" parent="col">
            <mxGeometry as="geometry" x="19" y="193" width="206" height="36" />
          </mxCell>
        </object>
        <mxCell id="view-element" value="" edge="1" parent="col" source="pc" target="element" style="noEdgeStyle=1;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="element-offset" value="" edge="1" parent="col" source="element" target="offset" style="noEdgeStyle=1;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="kernel-detail" name="sumRange 内部调用">
    <mxGraphModel tooltips="1" fold="1" connect="1" page="1" pageWidth="980" pageHeight="720">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <object id="back" label="返回 sumRange" tooltip="sumRange 在 demo/grid.cc:36 调用 readValue。&#10;打开调用图可返回定义节点。" link="data:page/id,overview">
          <mxCell style="rounded=1;whiteSpace=wrap;fontSize=18;fontStyle=1;fontFamily=Times New Roman,Helvetica,Arial,sans-serif;" vertex="1" parent="1">
            <mxGeometry as="geometry" x="60" y="115" width="155" height="46" />
          </mxCell>
        </object>
        <object id="bf" label="readValue" tooltip="unsigned readValue(const unsigned* values)&#10;&#10;功能&#10;读取当前元素。&#10;&#10;参数&#10;- values：指向待读取的元素。&#10;&#10;源码&#10;demo/grid.cc:29">
          <mxCell style="rounded=1;whiteSpace=wrap;fontSize=18;fontStyle=1;fontFamily=Times New Roman,Helvetica,Arial,sans-serif;" vertex="1" parent="1">
            <mxGeometry as="geometry" x="350" y="115" width="155" height="46" />
          </mxCell>
        </object>
        <mxCell id="combine" value="" source="back" target="bf" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;rounded=1;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
