          </mxCell>
        </object>
        <object id="api-tooltip" label="" tooltip="unsigned sumGrid(const unsigned* values, bool byRow)&#10;&#10;Purpose&#10;Sum the second row or the second column.&#10;&#10;Parameters&#10;- values: The row-major 2-by-2 grid.&#10;- byRow: Selects the second row when true and the second column when false.&#10;&#10;Source&#10;demo/grid.cc:57">
          <mxCell parent="api" vertex="1" connectable="0" style="ellipse;aspect=fixed;fillColor=#FFD966;strokeColor=#B58D17;strokeWidth=1;tooltipCell=1;movable=0;resizable=0;rotatable=0;deletable=0;">
            <mxGeometry x="1" y="0" width="11" height="11" relative="1" as="geometry">
