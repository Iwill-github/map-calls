          </mxCell>
        </object>
        <object id="kernel" label="sumRange" tooltip="unsigned sumRange(const unsigned* values, unsigned count, unsigned stride)&#10;&#10;Purpose&#10;Read the current element and recursively sum the rest when count is greater than one.&#10;&#10;Parameters&#10;- values: Points to the first element to sum.&#10;- count: The remaining number of elements.&#10;- stride: The distance between elements, in array elements.&#10;&#10;Source&#10;demo/grid.cc:34" link="data:page/id,kernel-detail">
