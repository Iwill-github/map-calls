        <object id="pr" label="secondRow" tooltip="const unsigned* secondRow(const unsigned* values)&#10;&#10;Purpose&#10;Return a pointer to the first element of the second row.&#10;&#10;Parameters&#10;- values: The row-major 2-by-2 grid.&#10;&#10;Source&#10;demo/grid.cc:9">
