            </mxGeometry>
          </mxCell>
        </object>
        <object id="col" label="sumColumn" tooltip="unsigned sumColumn(const unsigned* values)&#10;&#10;Purpose&#10;Sum the second column using a stride of two.&#10;&#10;Parameters&#10;- values: The row-major 2-by-2 grid.&#10;&#10;Source&#10;demo/grid.cc:48">
